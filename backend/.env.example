# Secret key used for signing JWT access tokens (min 32 characters recommended)
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars

# Database connection URL (defaults to SQLite; supports PostgreSQL)
DATABASE_URL=sqlite:///./issue_tracker.db

# Access token lifespan in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173
